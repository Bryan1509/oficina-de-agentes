# Copia este archivo, renómbralo a ".env" y pega tu clave después del "=".
# Nunca compartas el archivo .env ni lo subas a GitHub.
ANTHROPIC_API_KEY=

# Opcional: modelo que usan los agentes.
# claude-opus-5-5 (recomendado) · claude-sonnet-5-5 (más barato) · claude-haiku-5-5 (el más barato)
MODELO=claude-opus-5-5

# Opcional: cuánto "piensa" cada agente: low | medium | high
ESFUERZO=medium
